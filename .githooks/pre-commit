#!/usr/bin/env bash
# pre-commit hook �?两项检查：
# 1. 前端 typecheck（暂存区�?web/default/ 下的 TS/TSX 时）
# 2. changelog 门禁（有实质性代码变更但 changes/ 未更新时阻断提交�?

set -e

# === 1. Frontend typecheck ===

STAGED_TS=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^web/default/.*\.(tsx?|mts|cts)$' || true)

if [ -n "$STAGED_TS" ]; then
  echo "[pre-commit] Staged TS/TSX files detected in web/default/, running typecheck..."

  if command -v bun >/dev/null 2>&1; then
    RUNNER="bun run"
  else
    RUNNER="npm run"
  fi

  (cd web/default && $RUNNER typecheck)
  echo "[pre-commit] typecheck passed."
fi

# === 2. Changelog check ===

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

SUBSTANTIVE=$(echo "$STAGED_FILES" | grep -vE '^(changes/|\.cursor/|\.claude/|\.agents/|\.githooks/|\.github/|bin/|docs/|logs/|electron/|\.gitignore$|\.dockerignore$|\.env$|\.env\.example$|\.gitattributes$|package-lock\.json$|bun\.lockb$|go\.sum$|makefile$|Dockerfile$|Dockerfile\.dev$|docker-compose\.yml$|docker-compose\.dev\.yml$|new-api\.service$|VERSION$|LICENSE$|NOTICE$|.*\.md$)' || true)

CHANGELOG_UPDATED=$(echo "$STAGED_FILES" | grep -E '^changes/' || true)

if [ -z "$SUBSTANTIVE" ] || [ -n "$CHANGELOG_UPDATED" ]; then
  exit 0
fi

echo ""
echo "[pre-commit] �?检测到实质性代码变更，�?changes/ 目录未更新�?
echo ""
echo "  请在提交前使�?/changelog 指令更新 changes/CHANGELOG.md�?
echo "  如果本次变更无需记录（纯格式�?注释等），可使用 --no-verify 跳过�?
echo ""
echo "    git commit --no-verify"
echo ""
exit 1
